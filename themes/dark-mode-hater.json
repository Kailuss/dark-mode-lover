        "textPreformat.foreground"                         : "#000c"    ,

        //? ─── Title Bar ─────────────────────────────────────────────────────────────────────
        "titleBar.activeBackground"                        : "#fff"     ,
        "titleBar.activeForeground"                        : "#0006"     ,
        "titleBar.border"                                  : "#0000"    ,
        "titleBar.inactiveBackground"                      : "#fff"     ,
        "titleBar.inactiveForeground"                      : "#0002"     ,

        //? ─── Tree & Misc ───────────────────────────────────────────────────────────────────
        "tree.indentGuidesStroke"                          : "#0002",
        "walkThrough.embeddedEditorBackground"             : "#202032"  ,
        "welcomePage.progress.background"                  : "#5ca5ff66"  ,
        "welcomePage.tileBackground"                       : "#d9d6d0"  ,
        "widget.border"                                    : "#fff1"    ,
        "window.activeBorder"                              : "#e5e2dc"
