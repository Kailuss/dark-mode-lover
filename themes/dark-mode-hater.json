{
    "$schema": "vscode://schemas/color-theme",
    "name": "Dark Mode Hater",
    "type": "light",
    "semanticHighlighting": true,

    "semanticTokenColors": {

        //? ─── Variables ─────────────────────────────────────────────────────────────────────
        "variable"                : { "foreground": "#000a"  , "fontStyle": ""            },
        "variable.readonly"       : { "foreground": "#000a"  , "fontStyle": ""            },
        "variable.defaultLibrary" : { "foreground": "#000a"  , "fontStyle": "italic"      },
        "variable.modification"   : { "foreground": "#000a"  , "fontStyle": "underline"   },

//? ─── Properties ────────────────────────────────────────────────────────────────────
        "property"                : { "foreground": "#0006"  , "fontStyle": ""         },
        "property.declaration"    : { "foreground": "#0006"  , "fontStyle": ""         },
        "property.readonly"       : { "foreground": "#0006"  , "fontStyle": ""         },
        "property.static"         : { "foreground": "#0006"  , "fontStyle": "italic"   },
        "property.defaultLibrary" : { "foreground": "#0006"  , "fontStyle": ""         },
        //? ─── Parameters ────────────────────────────────────────────────────────────────────
        "parameter"               : { "foreground": "#e9aa44"  , "fontStyle": "italic"   },
        "parameter.readonly"      : { "foreground": "#e9aa44"  , "fontStyle": "italic"   },

        //? ─── Functions & Methods ───────────────────────────────────────────────────────────
        "function"                : { "foreground": "#278ddb"  , "fontStyle": ""         },
        "function.declaration"    : { "foreground": "#278ddb"  , "fontStyle": ""         },
        "function.async"          : { "foreground": "#278ddb"  , "fontStyle": "italic"   },
        "function.defaultLibrary" : { "foreground": "#278ddb"  , "fontStyle": ""         },
        "method"                  : { "foreground": "#278ddb"  , "fontStyle": ""         },
        "method.declaration"      : { "foreground": "#278ddb"  , "fontStyle": ""         },
        "method.static"           : { "foreground": "#278ddb"  , "fontStyle": "italic"   },
        "method.async"            : { "foreground": "#278ddb"  , "fontStyle": "italic"   },
        "method.defaultLibrary"   : { "foreground": "#278ddb"  , "fontStyle": ""         },
        //? ─── Types & Classes ───────────────────────────────────────────────────────────────
        "class"                   : { "foreground": "#a63a"  , "fontStyle": ""         },
        "class.declaration"       : { "foreground": "#a63a"  , "fontStyle": ""         },
        "class.defaultLibrary"    : { "foreground": "#a63a"  , "fontStyle": "italic"   },
        "interface"               : { "foreground": "#a63a"  , "fontStyle": "italic"   },
        "interface.declaration"   : { "foreground": "#a63a"  , "fontStyle": "italic"   },
        "struct"                  : { "foreground": "#a63a"  , "fontStyle": ""         },
        "type"                    : { "foreground": "#48c9ec"  , "fontStyle": ""         },
        "type.defaultLibrary"     : { "foreground": "#48c9ec"  , "fontStyle": "italic"   },
        "namespace"               : { "foreground": "#48c9ec"  , "fontStyle": ""         },
        "enum"                    : { "foreground": "#48c9ec"  , "fontStyle": ""         },
        "enumMember"              : { "foreground": "#c65e34"  , "fontStyle": ""         },
        "typeParameter"           : { "foreground": "#d69ad8"  , "fontStyle": "italic"   },

        //? ─── Keywords & Modifiers ──────────────────────────────────────────────────────────
        "keyword"                 : { "foreground": "#d67ab8"  , "fontStyle": "italic"   },
        "selfKeyword"             : { "foreground": "#d67ab8"  , "fontStyle": "italic"   },

        //? ─── Decorators & Meta ─────────────────────────────────────────────────────────────
        "decorator"               : { "foreground": "#7a68a8"  , "fontStyle": "italic"   },
        "macro"                   : { "foreground": "#0006"    , "fontStyle": "italic"   },

        //? ─── Special Modifiers (wildcards) ─────────────────────────────────────────────────
        "*.declaration"           : { "fontStyle" : ""                                   },
        "*.deprecated"            : { "fontStyle" : "strikethrough"                      },
        "*.defaultLibrary"        : { "foreground": "#7a68a8"                            },
        "*.modification"          : { "fontStyle" : "underline"                          },
        "*.documentation"         : { "fontStyle" : "italic"                             },
        "*.abstract"              : { "fontStyle" : "italic"                             },
        "*.readonly"              : { "fontStyle" : ""                                   }
    },

    "colors": {

        //? ─── Modern additions (VS Code 2024–2026) ─────────────────────────────
        "commandCenter.foreground"                         : "#0007",
        "commandCenter.activeForeground"                   : "#000c",
        "commandCenter.inactiveForeground"                 : "#0005",
        "commandCenter.background"                         : "#0001",
        "commandCenter.activeBackground"                   : "#0002",
        "commandCenter.border"                             : "#0002",
        "editorStickyScroll.background"                    : "#e5e2dc",
        "editorStickyScroll.shadow"                        : "#0003",
        "editorStickyScrollHover.background"               : "#0001",
        "editorInlayHint.foreground"                       : "#0006",
        "editorInlayHint.background"                       : "#0000",
        "editorInlayHint.typeForeground"                   : "#48c9ec",
        "editorInlayHint.parameterForeground"              : "#e9aa44",
        "editorGhostText.foreground"                       : "#0004",
        "editorGutter.foldingControlForeground"            : "#0007",
        "sash.hoverBorder"                                 : "#49f",
        "toolbar.hoverBackground"                          : "#0001",
        "terminalStickyScroll.background"                  : "#e9e7e3",

        //? --- Menu --------------------------------------------------------------------------
        "menu.background"                                   : "#e5e2dc"  ,
        "menu.foreground"                                   : "#0008"  ,
        "menu.border"                                       : "#fff6"  ,
        "menu.separatorBackground"                          : "#0002"  ,
        "menu.selectionBackground"                          : "#5ca5ff"  ,
        "menu.selectionForeground"                          : "#fff"  ,

        //? ─── Activity Bar ──────────────────────────────────────────────────────────────────
        "activityBar.activeBorder"                         : "#5ca5ff"     ,
        "activityBar.background"                           : "#fff"     ,
        "activityBar.border"                               : "#e9e9db"  ,
        "activityBar.foreground"                           : "#5ca5ff"     ,
        "activityBar.inactiveForeground"                   : "#5ca5ffaa"    ,
        "activityBarBadge.background"                      : "#f95"     ,
        "activityBarBadge.foreground"                      : "#fff"     ,

        //? ─── Badge ─────────────────────────────────────────────────────────────────────────
        "badge.background"                                 : "#f95"     ,
        "badge.foreground"                                 : "#fff"     ,

        //? ─── Buttons ───────────────────────────────────────────────────────────────────────
        "button.background"                                : "#5ca5ff"     ,
        "button.foreground"                                : "#000c"    ,
        "button.hoverBackground"                           : "#49f"     ,
        "button.secondaryBackground"                       : "#fff6",
        "button.secondaryForeground"                       : "#0009"    ,
        "button.secondaryHoverBackground"                  : "#fffa",

        //? ─── Debug ─────────────────────────────────────────────────────────────────────────
        "debugConsoleInputIcon.foreground"                 : "#39f"     ,
        "debugIcon.breakpointDisabledForeground"           : "#f969"    ,
        "debugIcon.breakpointForeground"                   : "#f96"     ,
        "debugToolBar.background"                          : "#202032"  ,

        //? ─── General ───────────────────────────────────────────────────────────────────────
        "descriptionForeground"                            : "#0007"  ,
        "focusBorder"                                      : "#5ca5ff"    ,
        "foreground"                                       : "#0007"  ,
        "icon.foreground"                                  : "#0007"  ,
        "selection.background"                             : "#5ca5ff66"    ,

        //? ─── Diff Editor ──────────────────────────────────────────────────────────────────
        "diffEditor.diagonalFill"                          : "#e9e9db"  ,
        "diffEditor.insertedTextBackground"                : "#8d72"    ,
        "diffEditor.removedTextBackground"                 : "#f312"    ,

        //? ─── Dropdown ──────────────────────────────────────────────────────────────────────
        "dropdown.background"                              : "#e5e2dc"  ,
        "dropdown.border"                                  : "#fff3",
        "dropdown.foreground"                              : "#000a"    ,

        //? ─── Editor ────────────────────────────────────────────────────────────────────────
        "editor.background"                                : "#e5e2dc"  ,
        "editor.foreground"                                : "#0007"  ,
        "editor.findMatchBackground"                       : "#695380"  ,
        "editor.findMatchBorder"                           : "#695380"  ,
        "editor.findMatchHighlightBackground"              : "#69538099",
        "editor.findMatchHighlightBorder"                  : "#5c467299",
        "editor.findRangeHighlightBackground"              : "#69538066",
        "editor.inactiveSelectionBackground"               : "#4080ff21",
        "editor.lineHighlightBackground"                   : "#00000033",
        "editor.rangeHighlightBackground"                  : "#69538033",
        "editor.selectionBackground"                       : "#4080ff24",
        "editor.selectionHighlightBackground"              : "#88dd6626",
        "editor.selectionHighlightBorder"                  : "#88dd6600",
        "editor.snippetTabstopHighlightBackground"         : "#88dd6633",
        "editor.wordHighlightBackground"                   : "#66ccff14",
        "editor.wordHighlightBorder"                       : "#66ccff80",
        "editor.wordHighlightStrongBackground"             : "#88dd6614",
        "editor.wordHighlightStrongBorder"                 : "#88dd6680",

        //? ─── Editor Bracket Highlight ──────────────────────────────────────────────────────
        "editorBracketHighlight.foreground1"               : "#e9aa44"  ,
        "editorBracketHighlight.foreground2"               : "#46f"  ,
        "editorBracketHighlight.foreground3"               : "#4ed"  ,
        "editorBracketHighlight.foreground4"               : "#4d7"  ,
        "editorBracketMatch.background"                    : "#5c606b4d",
        "editorBracketMatch.border"                        : "#5c606b2d",
        "editorBracketPairGuide.activeBackground1"         : "#4070ff80",
        "editorBracketPairGuide.activeBackground2"         : "#2288dd80",
        "editorBracketPairGuide.activeBackground3"         : "#11aabb80",
        "editorBracketPairGuide.activeBackground4"         : "#00cc9980",
        "editorBracketPairGuide.background1"               : "#4070ff33",
        "editorBracketPairGuide.background2"               : "#2288dd33",
        "editorBracketPairGuide.background3"               : "#11aabb33",
        "editorBracketPairGuide.background4"               : "#00cc9933",

        //? ─── Editor Code Lens & Cursor ─────────────────────────────────────────────────────
        "editorCodeLens.foreground"                        : "#0003"    ,
        "editorCursor.foreground"                          : "#39f"     ,
        "editorError.foreground"                           : "#d55"    ,

        //? ─── Editor Groups & Tabs Header ───────────────────────────────────────────────────
        "editorGroupHeader.tabsBackground"                 : "#e9e7e3"  ,

        //? ─── Editor Gutter ─────────────────────────────────────────────────────────────────
        "editorGutter.addedBackground"                     : "#8d69"    ,
        "editorGutter.deletedBackground"                   : "#d559"    ,
        "editorGutter.modifiedBackground"                  : "#6cf9"    ,

        //? ─── Editor Hover & Widgets ────────────────────────────────────────────────────────
        "editorHoverWidget.background"                     : "#e5e2dc"  ,
        "editorHoverWidget.border"                         : "#e9e9db"  ,
        "editorWidget.background"                          : "#d9d6d0"  ,
        "editorWidget.border"                              : "#e9e9db"  ,

        //? ─── Editor Indent Guides ──────────────────────────────────────────────────────────
        "editorIndentGuide.activeBackground1"              : "#8E8EAE56",
        "editorIndentGuide.background1"                    : "#8a91992e",

        //? ─── Editor Line Numbers ───────────────────────────────────────────────────────────
        "editorLineNumber.activeForeground"                : "#000c"    ,
        "editorLineNumber.foreground"                      : "#0002"  ,

        //? ─── Editor Links ──────────────────────────────────────────────────────────────────
        "editorLink.activeForeground"                      : "#39f"     ,

        //? ─── Editor Marker Navigation ──────────────────────────────────────────────────────
        "editorMarkerNavigation.background"                : "#202032"  ,

        //? ─── Editor Overview Ruler ─────────────────────────────────────────────────────────
        "editorOverviewRuler.addedForeground"              : "#8d7"     ,
        "editorOverviewRuler.border"                       : "#e9e9db"  ,
        "editorOverviewRuler.bracketMatchForeground"       : "#8a9199b3",
        "editorOverviewRuler.deletedForeground"            : "#f88"     ,
        "editorOverviewRuler.errorForeground"              : "#f66"     ,
        "editorOverviewRuler.findMatchForeground"          : "#69538099",
        "editorOverviewRuler.modifiedForeground"           : "#66ccff"  ,
        "editorOverviewRuler.warningForeground"            : "#39f"     ,
        "editorOverviewRuler.wordHighlightForeground"      : "#66ccff66",
        "editorOverviewRuler.wordHighlightStrongForeground": "#88dd6666",

        //? ─── Editor Ruler & Whitespace ─────────────────────────────────────────────────────
        "editorRuler.foreground"                           : "#0002",
        "editorWhitespace.foreground"                      : "#0003",

        //? ─── Breadcrumb ────────────────────────────────────────────────────────────────────
        "breadcrumb.background"                            : "#d9d6d0"  ,
        "breadcrumb.foreground"                            : "#0007"    ,

        //? ─── Inline Chat ───────────────────────────────────────────────────────────────────
        "inlineChat.background"                            : "#e9e7e3"  ,
        "inlineChatInput.background"                       : "#e9e7e3"  ,
        "inlineChatInput.border"                           : "#70758045",

        //? ─── Quick Input ───────────────────────────────────────────────────────────────────
        "quickInput.background"                            : "#111118"  ,
        "quickInput.foreground"                            : "#000c"    ,
        "quickInputList.focusBackground"                   : "#49f"     ,
        "quickInputList.focusForeground"                   : "#e9e7e3"  ,
        "quickInputList.focusIconForeground"               : "#5ca5ff"     ,

        //? ─── Extension Buttons ─────────────────────────────────────────────────────────────
        "extensionButton.prominentBackground"              : "#39f"     ,
        "extensionButton.prominentForeground"              : "#000c"    ,
        "extensionButton.prominentHoverBackground"         : "#4af"     ,

        //? ─── Git Decoration ────────────────────────────────────────────────────────────────
        "gitDecoration.conflictingResourceForeground"      : "#fb6e"    ,
        "gitDecoration.deletedResourceForeground"          : "#f86e"    ,
        "gitDecoration.ignoredResourceForeground"          : "#777e"    ,
        "gitDecoration.modifiedResourceForeground"         : "#6cfe"    ,
        "gitDecoration.submoduleResourceForeground"        : "#c9fe"    ,
        "gitDecoration.untrackedResourceForeground"        : "#8e7e"    ,

        //? ─── Input ─────────────────────────────────────────────────────────────────────────
        "input.background"                                 : "#e5e2dc"  ,
        "input.border"                                     : "#70758045",
        "input.foreground"                                 : "#000c"    ,
        "input.placeholderForeground"                      : "#70758080",
        "inputOption.activeBackground"                     : "#49f3"    ,
        "inputOption.activeBorder"                         : "#49f5"    ,
        "inputOption.activeForeground"                     : "#39f"     ,
        "inputValidation.errorBackground"                  : "#e5e2dc"  ,
        "inputValidation.errorBorder"                      : "#f66"     ,
        "inputValidation.infoBackground"                   : "#e5e2dc"  ,
        "inputValidation.infoBorder"                       : "#5ccfe6"  ,
        "inputValidation.warningBackground"                : "#e5e2dc"  ,
        "inputValidation.warningBorder"                    : "#49f"     ,

        //? ─── Keybinding Label ──────────────────────────────────────────────────────────────
