        "keybindingLabel.border"                           : "#0002"    ,
        "keybindingLabel.bottomBorder"                     : "#0003"    ,
        "keybindingLabel.foreground"                       : "#000c"    ,

        //? ─── List ──────────────────────────────────────────────────────────────────────────
        "list.activeSelectionBackground"                   : "#679c"    ,
        "list.activeSelectionForeground"                   : "#000c"    ,
        "list.deemphasizedForeground"                      : "#f669"    ,
        "list.errorForeground"                             : "#f669"    ,
        "list.filterMatchBackground"                       : "#8596"    ,
        "list.filterMatchBorder"                           : "#8596"    ,
        "list.focusBackground"                             : "#63759926",
        "list.focusForeground"                             : "#000c"    ,
        "list.focusOutline"                                : "#fff2"    ,
        "list.highlightForeground"                         : "#39f"     ,
        "list.hoverBackground"                             : "#63759926",
        "list.inactiveSelectionBackground"                 : "#69758c1f",
        "list.inactiveSelectionForeground"                 : "#707580"  ,
        "list.invalidItemForeground"                       : "#7075804d",
        "listFilterWidget.background"                      : "#202032"  ,
        "listFilterWidget.noMatchesOutline"                : "#f66"     ,
        "listFilterWidget.outline"                         : "#49f"     ,

        //? ─── Minimap ───────────────────────────────────────────────────────────────────────
        "minimap.background"                               : "#e5e2dc"  ,
        "minimap.errorHighlight"                           : "#f669"     ,
        "minimap.findMatchHighlight"                       : "#859d"  ,
        "minimap.selectionHighlight"                       : "#5ca5ff44",
        "minimapSlider.background"                         : "#49f3",
        "minimapSlider.hoverBackground"                    : "#49f3",
        "minimapSlider.activeBackground"                   : "#49f6",
        "minimapGutter.addedBackground"                    : "#9d74"    ,
        "minimapGutter.deletedBackground"                  : "#d884"   ,
        "minimapGutter.modifiedBackground"                 : "#6cf4",

        //? ─── Panel ─────────────────────────────────────────────────────────────────────────
        "panel.background"                                 : "#e9e7e3"  ,
        "panel.border"                                     : "#fefefc"  ,
        "panelTitle.activeBorder"                          : "#49f"     ,
        "panelTitle.activeForeground"                      : "#000c"  ,
        "panelTitle.inactiveForeground"                    : "#0006"  ,

        //? ─── Peek View ─────────────────────────────────────────────────────────────────────
        "peekView.border"                                  : "#49f9"    ,
        "peekViewEditor.background"                        : "#e9e7e3"  ,
        "peekViewEditor.matchHighlightBackground"          : "#49f6"    ,
        "peekViewEditor.matchHighlightBorder"              : "#49f9"    ,
        "peekViewResult.background"                        : "#e9e7e3"  ,
        "peekViewResult.fileForeground"                    : "#000c"  ,
        "peekViewResult.lineForeground"                    : "#0006"  ,
        "peekViewResult.matchHighlightBackground"          : "#49f6"    ,
        "peekViewResult.selectionBackground"               : "#fff1",
        "peekViewTitle.background"                         : "#fff1",
        "peekViewTitleDescription.foreground"              : "#0006"  ,
        "peekViewTitleLabel.foreground"                    : "#000c"  ,

        //? ─── Picker ────────────────────────────────────────────────────────────────────────
        "pickerGroup.border"                               : "#e9e9db"  ,
        "pickerGroup.foreground"                           : "#0003",

        //? ─── Progress Bar ──────────────────────────────────────────────────────────────────
        "progressBar.background"                           : "#49f"     ,

        //? ─── Scrollbar ─────────────────────────────────────────────────────────────────────
        "scrollbar.shadow"                                 : "#00000000",
        "scrollbarSlider.activeBackground"                 : "#3e405488",
        "scrollbarSlider.background"                       : "#3e405455",
        "scrollbarSlider.hoverBackground"                  : "#3e405488",

        //? ─── Settings ──────────────────────────────────────────────────────────────────────
        "settings.headerForeground"                        : "#0009",
        "settings.modifiedItemIndicator"                   : "#49f"  ,

        //? ─── Sidebar ───────────────────────────────────────────────────────────────────────
        "sideBar.background"                               : "#e9e7e3"  ,
        "sideBar.border"                                   : "#fefefc"  ,
        "sideBar.foreground"                               : "#0007",
        "sideBar.dropBackground"                           : "#0002",
        "sideBarSectionHeader.background"                  : "#d9d6d0"  ,
        "sideBarSectionHeader.border"                      : "#fefefc"  ,
        "sideBarSectionHeader.foreground"                  : "#0004",
        "sideBarTitle.foreground"                          : "#49f"  ,

        //? ─── Status Bar ────────────────────────────────────────────────────────────────────
        "statusBar.background"                             : "#fff"     ,
        "statusBar.border"                                 : "#fefefc"  ,
        "statusBar.debuggingBackground"                    : "#f29e74"  ,
        "statusBar.debuggingForeground"                    : "#d9d6d0"  ,
        "statusBar.foreground"                             : "#0007",
        "statusBar.noFolderBackground"                     : "#e5e2dc"  ,
        "statusBarItem.activeBackground"                   : "#70758033",
        "statusBarItem.hoverBackground"                    : "#70758033",
        "statusBarItem.prominentBackground"                : "#e9e9db"  ,
        "statusBarItem.prominentHoverBackground"           : "#00000030",
        "statusBarItem.remoteBackground"                   : "#28d"     ,
        "statusBarItem.remoteForeground"                   : "#000c",

        //? ─── Tabs ──────────────────────────────────────────────────────────────────────────
        "tab.activeBackground"                             : "#d9d6d0"  ,
        "tab.activeBorder"                                 : "#0000"    ,
        "tab.activeBorderTop"                              : "#49f"  ,
        "tab.activeForeground"                             : "#000c"  ,
        "tab.border"                                       : "#e9e9db"  ,
        "tab.inactiveBackground"                           : "#e9e7e3"  ,
        "tab.inactiveForeground"                           : "#0006"  ,
        "tab.unfocusedActiveBorderTop"                     : "#0006"  ,
        "tab.unfocusedActiveForeground"                    : "#0006"  ,
        "tab.unfocusedInactiveForeground"                  : "#0006"  ,

        //? ─── Terminal ──────────────────────────────────────────────────────────────────────
        "terminal.ansiBlack"                               : "#fefefc"  ,
        "terminal.ansiBlue"                                : "#39f"     ,
        "terminal.ansiBrightBlack"                         : "#222"  ,
        "terminal.ansiBrightBlue"                          : "#6bf"  ,
        "terminal.ansiBrightCyan"                          : "#9fd"  ,
        "terminal.ansiBrightGreen"                         : "#9d8"     ,
        "terminal.ansiBrightMagenta"                       : "#f7a"     ,
        "terminal.ansiBrightRed"                           : "#f88"     ,
        "terminal.ansiBrightWhite"                         : "#eed"  ,
        "terminal.ansiBrightYellow"                        : "#fd8"     ,
        "terminal.ansiCyan"                                : "#7dc"  ,
        "terminal.ansiGreen"                               : "#8d7"     ,
        "terminal.ansiMagenta"                             : "#dbf"  ,
        "terminal.ansiRed"                                 : "#e66"  ,
        "terminal.ansiWhite"                               : "#ccb"  ,
        "terminal.ansiYellow"                              : "#fc6"     ,
        "terminal.background"                              : "#e9e7e3"  ,
        "terminal.foreground"                              : "#ccb"  ,

        //? ─── Text ──────────────────────────────────────────────────────────────────────────
