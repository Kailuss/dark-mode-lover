{
    "$schema": "vscode://schemas/color-theme",
    "name": "Dark Mode Syntax",
    "type": "dark",
    "semanticHighlighting": true,

    "semanticTokenColors": {

        //? ─── Variables ─────────────────────────────────────────────────────────────────────
        "variable"                : { "foreground": "#fff7"  , "fontStyle": ""            },
        "variable.readonly"       : { "foreground": "#fff7"  , "fontStyle": ""            },
        "variable.defaultLibrary" : { "foreground": "#fff7"  , "fontStyle": "italic"      },
        "variable.modification"   : { "foreground": "#fff7"  , "fontStyle": "underline"   },
        //? ─── Properties ────────────────────────────────────────────────────────────────────
        "property"                : { "foreground": "#fffb"  , "fontStyle": ""            },
        "property.declaration"    : { "foreground": "#fffb"  , "fontStyle": ""            },
        "property.readonly"       : { "foreground": "#fffb"  , "fontStyle": ""            },
        "property.static"         : { "foreground": "#fffb"  , "fontStyle": "italic"      },
        "property.defaultLibrary" : { "foreground": "#fffb"  , "fontStyle": ""            },
        //? ─── Parameters ────────────────────────────────────────────────────────────────────
        "parameter"               : { "foreground": "#fa5"   , "fontStyle": "italic"      },
        "parameter.readonly"      : { "foreground": "#fb6"   , "fontStyle": "italic"      },
        //? ─── Functions & Methods ───────────────────────────────────────────────────────────
        "function"                : { "foreground": "#6bf"   , "fontStyle": ""            },
        "function.declaration"    : { "foreground": "#6bf"   , "fontStyle": ""            },
        "function.async"          : { "foreground": "#6bf"   , "fontStyle": "italic"      },
        "function.defaultLibrary" : { "foreground": "#6bf"   , "fontStyle": ""            },
        "method"                  : { "foreground": "#6bf"   , "fontStyle": ""            },
        "method.declaration"      : { "foreground": "#6bf"   , "fontStyle": ""            },
        "method.static"           : { "foreground": "#6bf"   , "fontStyle": "italic"      },
        "method.async"            : { "foreground": "#6bf"   , "fontStyle": "italic"      },
        "method.defaultLibrary"   : { "foreground": "#6bf"   , "fontStyle": ""            },
        //? ─── Types & Classes ───────────────────────────────────────────────────────────────
        "class"                   : { "foreground": "#fc6"   , "fontStyle": ""            },
        "class.declaration"       : { "foreground": "#fc6"   , "fontStyle": ""            },
        "class.defaultLibrary"    : { "foreground": "#fc6"   , "fontStyle": "italic"      },
        "interface"               : { "foreground": "#fc6"   , "fontStyle": "italic"      },
        "interface.declaration"   : { "foreground": "#fc6"   , "fontStyle": "italic"      },
        "struct"                  : { "foreground": "#fc6"   , "fontStyle": ""            },
        "type"                    : { "foreground": "#9cf"   , "fontStyle": ""            },
        "type.defaultLibrary"     : { "foreground": "#9cf"   , "fontStyle": "italic"      },
        "namespace"               : { "foreground": "#9cf"   , "fontStyle": ""            },
        "enum"                    : { "foreground": "#9cf"   , "fontStyle": ""            },
        "enumMember"              : { "foreground": "#b75"   , "fontStyle": ""            },
        "typeParameter"           : { "foreground": "#fab"   , "fontStyle": "italic"      },
        //? ─── Keywords & Modifiers ──────────────────────────────────────────────────────────
        "keyword"                 : { "foreground": "#f7a"   , "fontStyle": "italic"      },
        "selfKeyword"             : { "foreground": "#f7a"   , "fontStyle": "italic"      },
        //? ─── Decorators & Meta ─────────────────────────────────────────────────────────────
        "decorator"               : { "foreground": "#cae"   , "fontStyle": "italic"      },
        "macro"                   : { "foreground": "#fff2"  , "fontStyle": "italic"      },
        //? ─── Special Modifiers (wildcards) ─────────────────────────────────────────────────
        "*.declaration"           : { "fontStyle" : ""                                      },
        "*.deprecated"            : { "fontStyle" : "strikethrough"                         },
        "*.defaultLibrary"        : { "foreground": "#b7f"                                },
        "*.modification"          : { "fontStyle" : "underline"                             },
        "*.documentation"         : { "fontStyle" : "italic"                                },
        "*.abstract"              : { "fontStyle" : "italic"                                },
        "*.readonly"              : { "fontStyle" : ""                                      }
    },

    "tokenColors": [

        //! 1. COMMENTS ═══════════════════════════════════════════════════════════════════════

        {
            "name": "Comments",
            "scope": ["comment.line", "comment.block"],
            "settings": {
                "foreground": "#464",
                "fontStyle": ""
            }
        },
        {
            "name": "Documentation Comments",
            "scope": [
                "comment.block.documentation",
                "comment.block.javadoc",
                "comment.block.html",
                "punctuation.definition.comment.documentation"
            ],
            "settings": {
                "foreground": "#fff5",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Documentation Tags",
            "scope": [
                "storage.type.class.jsdoc",
                "keyword.other.documentation",
                "entity.name.type.instance.jsdoc",
                "variable.other.jsdoc"
            ],
            "settings": { "foreground": "#46c" }
        },
        {
            "name": "XML Documentation Tags",
            "scope": [
                "comment.block.documentation entity.name.tag",
                "comment.block.documentation punctuation.definition.tag"
            ],
            "settings": { "foreground": "#fff3" }
        },

        //! 2. CONSTANTS ══════════════════════════════════════════════════════════════════════

        {
            "name": "Numeric Constants",
            "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float", "constant.numeric.hex"],
            "settings": {
                "foreground": "#e66",
                "fontStyle": ""
            }
        },
        {
            "name": "Language Constants (true, false, null)",
            "scope": ["constant.language"],
            "settings": {
                "foreground": "#b7f",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Other Constants",
            "scope": ["constant.other", "support.constant"],
            "settings": { "foreground": "#b7f" }
        },
        {
            "name": "Character Escapes",
            "scope": ["constant.character.escape"],
            "settings": { "foreground": "#6de" }
        },

        //! 3. STRINGS ════════════════════════════════════════════════════════════════════════

        {
            "name": "Strings",
            "scope": ["string", "string.quoted", "string.template"],
            "settings": {
                "foreground": "#9c6",
                "fontStyle": ""
            }
        },
        {
            "name": "Regular Expressions",
            "scope": ["string.regexp"],
            "settings": { "foreground": "#6de" }
        },
        {
            "name": "String URLs",
            "scope": ["string.url", "string.other.link"],
            "settings": {
                "foreground": "#6de",
                "fontStyle": "underline"
            }
        },

        //! 4. ENTITIES (Tags, Types, Functions) ══════════════════════════════════════════════

        //? ─── Types & Classes ─────────────────────────────────────────────────────────────
        {
            "name": "Type / Class Names",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.other.inherited-class",
                "support.class",
                "support.type"
            ],
            "settings": { "foreground": "#fc7" }
        },
        {
            "name": "Primitive Types (bool, int, string)",
            "scope": [
                "storage.type.primitive",
                "keyword.type",
                "support.type.primitive"
            ],
            "settings": { "foreground": "#fc6" }
        },
        {
            "name": "Type Annotations",
            "scope": ["meta.type.annotation", "support.type.builtin"],
            "settings": { "foreground": "#fc7" }
        },

        //? ─── Tags (HTML/XML) ─────────────────────────────────────────────────────────────
        {
            "name": "HTML/XML Tags",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#e66" }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#fc6" }
        },
        {
            "name": "JSX/TSX Components",
            "scope": [
                "support.class.component",
                "entity.name.tag.jsx",
                "entity.name.tag.tsx"
            ],
            "settings": { "foreground": "#fac" }
        },

        //? ─── CSS Property Names ──────────────────────────────────────────────────────────
        {
            "name": "CSS Property Names",
            "scope": ["support.type.property-name", "support.type.property-name.css"],
            "settings": { "foreground": "#e66" }
        },

        //? ─── Functions ─────────────────────────────────────────────────────────────────────
        {
            "name": "Function Declarations",
            "scope": [
                "entity.name.function",
                "entity.name.function.member",
                "meta.definition.function entity.name.function",
                "meta.definition.method entity.name.function"
            ],
            "settings": {
                "foreground": "#6bf",
                "fontStyle": ""
            }
        },
        {
            "name": "Function Calls",
            "scope": [
                "meta.function-call.generic",
                "entity.name.function.call",
                "support.function"
            ],
            "settings": { "foreground": "#6bf" }
        },
        {
            "name": "Built-in Functions",
            "scope": [
                "support.function.builtin",
                "support.function.console",
                "support.function.dom"
            ],
            "settings": { "foreground": "#6de" }
        },
        {
            "name": "Constructors",
            "scope": [
                "entity.name.function.constructor",
                "meta.function-call.constructor"
            ],
            "settings": {
                "foreground": "#fc7",
                "fontStyle": ""
            }
        },

        //! 5. KEYWORDS (Control Flow, Storage, Operators) ══════════════════════════════════

        //? ─── Control Flow ────────────────────────────────────────────────────────────────
        {
            "name": "Control Flow Keywords",
            "scope": [
                "keyword.control",
                "keyword.control.conditional",
                "keyword.control.loop",
                "keyword.control.flow"
            ],
            "settings": {
                "foreground": "#f7a",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Import/Export Keywords",
            "scope": [
                "keyword.control.import",
                "keyword.control.export",
                "keyword.control.from"
            ],
            "settings": {
                "foreground": "#f7a",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Other Keywords",
            "scope": ["keyword", "keyword.other"],
            "settings": {
                "foreground": "#f7a",
                "fontStyle": "italic"
            }
        },

        //? ─── Storage Types & Modifiers ────────────────────────────────────────────────────
        {
            "name": "Storage Types (class, function, def)",
            "scope": ["storage.type", "storage.type.class", "storage.type.function"],
            "settings": { 
                "foreground": "#f7a",
                "fontStyle": ""
            }
        },
        {
            "name": "Storage Modifiers (static, async, const)",
            "scope": [
                "storage.modifier",
                "storage.modifier.access",
                "storage.modifier.static",
                "storage.modifier.async",
                "storage.modifier.const",
                "storage.modifier.readonly"
            ],
            "settings": {
                "foreground": "#f7a",
                "fontStyle": ""
            }
        },
        {
            "name": "Declaration Keywords (new, typeof, instanceof)",
            "scope": [
                "keyword.operator.new",
                "keyword.operator.expression.typeof",
                "keyword.operator.expression.instanceof"
            ],
            "settings": {
                "foreground": "#f7a",
                "fontStyle": ""
            }
        },

        //? ─── Operators ─────────────────────────────────────────────────────────────────────
        {
            "name": "Operators",
            "scope": ["keyword.operator"],
            "settings": {
                "foreground": "#37c",
                "fontStyle": ""
            }
        },

        //! 6. VARIABLES ═════════════════════════════════════════════════════════════════════=

        {
            "name": "Variables",
            "scope": ["variable", "variable.other", "variable.other.readwrite"],
            "settings": { "foreground": "#fff7" }
        },
        {
            "name": "Variable Properties",
            "scope": ["variable.other.property", "variable.object.property", "variable.other.object"],
            "settings": { "foreground": "#fffa" }
        },
        {
            "name": "Parameters",
            "scope": ["variable.parameter"],
            "settings": {
                "foreground": "#fc6",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Enum Members",
            "scope": ["variable.other.enummember"],
            "settings": { "foreground": "#c86" }
        },
        {
            "name": "Language Variables (this, self)",
            "scope": [
                "variable.language.this",
                "variable.language.self",
                "variable.parameter.function.language.special.self",
                "variable.parameter.function.language.special.cls"
            ],
            "settings": {
                "foreground": "#e66",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Super Keyword",
            "scope": ["variable.language.super"],
            "settings": {
                "foreground": "#fac",
                "fontStyle": "italic"
            }
        },

        //! 7. MARKUP (Markdown, HTML content) ═══════════════════════════════════════════════

        {
            "name": "Markup Heading",
            "scope": ["markup.heading", "entity.name.section"],
            "settings": {
                "foreground": "#e66",
                "fontStyle": ""
            }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "Markup Strikethrough",
            "scope": ["markup.strikethrough"],
            "settings": { "fontStyle": "strikethrough" }
        },
        {
            "name": "Markup Link",
            "scope": ["markup.underline.link"],
            "settings": {
                "foreground": "#6de",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Markup Raw / Inline Code",
            "scope": ["markup.raw", "markup.inline.raw"],
            "settings": { "foreground": "#9c6a" }
        },
        {
            "name": "Markup Inserted (Diff)",
            "scope": ["markup.inserted"],
            "settings": { "foreground": "#9c6a" }
        },
        {
            "name": "Markup Deleted (Diff)",
            "scope": ["markup.deleted"],
            "settings": { "foreground": "#f88a" }
        },
        {
            "name": "Markup Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#9c6a" }
        },
        {
            "name": "Markup List",
            "scope": [
                "punctuation.definition.list.begin.markdown",
                "punctuation.definition.list.end.markdown"
            ],
            "settings": { "foreground": "#e66a" }
        },

        //! 8. PUNCTUATION ═══════════════════════════════════════════════════════════════════

        {
            "name": "Punctuation / Braces",
            "scope": [
                "meta.brace",
                "punctuation.accessor",
                "punctuation.definition.block",
                "punctuation.definition.tag",
                "punctuation.definition.binding-pattern",
                "punctuation.definition.parameters"
            ],
            "settings": {
                "foreground": "#fffa",
                "fontStyle": ""
            }
        },
        {
            "name": "Strings Punctuation",
            "scope": [
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#9c66",
                "fontStyle": ""
            }
        },
        {
            "name": "Punctuation Comments",
            "scope": [
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#fff2",
                "fontStyle": ""
            }
        },
        {
            "name": "Commas & Semicolons",
            "scope": [
                "punctuation.separator.comma",
                "punctuation.terminator.statement",
                "punctuation.separator.semicolon"
            ],
            "settings": { "foreground": "#fff3" }
        },
        {
            "name": "Template Expression Punctuation",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded"
            ],
            "settings": { "foreground": "#e66" }
        },

        //! 9. DECORATORS & META-PROGRAMMING ════════════════════════════════════════════════

        {
            "name": "Decorators / Annotations",
            "scope": [
                "meta.decorator",
                "entity.name.function.decorator",
                "punctuation.decorator"
            ],
            "settings": {
                "foreground": "#daf",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Namespaces / Modules",
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "storage.modifier.namespace",
                "support.other.namespace",
                "meta.import variable.other.readwrite",
                "variable.other.readwrite.alias",
                "variable.language.import-export"
            ],
            "settings": { "foreground": "#8cf" }
        },

        //! 10. INVALID ═════════════════════════════════════════════════════════════════════=

        {
            "name": "Invalid / Illegal",
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#e76e" }
        },
        {
            "name": "Invalid Deprecated",
            "scope": ["invalid.deprecated"],
            "settings": {
                "foreground": "#fff3",
                "fontStyle": "strikethrough"
            }
        },

        //! 11. LANGUAGE-SPECIFIC ════════════════════════════════════════════════════════════

        //? ─── CSS ──────────────────────────────────────────────────────────────────────────
        {
            "name": "CSS Values / Units",
            "scope": [
                "support.constant.property-value.css",
                "constant.numeric.css",
                "keyword.other.unit"
            ],
            "settings": { "foreground": "#9db" }
        },
        {
            "name": "CSS Important / Pseudo-classes",
            "scope": [
                "keyword.other.important",
                "entity.other.attribute-name.pseudo-class",
                "support.function.misc.css"
            ],
            "settings": { "foreground": "#38f" }
        },

        //? ─── C# ──────────────────────────────────────────────────────────────────────────────
        {
            "name": "C# LINQ Keywords",
            "scope": [
                "keyword.query.linq",
                "keyword.query.from",
                "keyword.query.where",
                "keyword.query.select"
            ],
            "settings": {
                "foreground": "#8cf",
                "fontStyle": "italic"
            }
        },
        {
            "name": "C# Async/Await",
            "scope": ["keyword.control.await", "storage.modifier.async"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "name": "C# Attributes",
            "scope": ["meta.attribute", "entity.name.type.attribute"],
            "settings": { "foreground": "#9db" }
        },

        //? ─── SQL ─────────────────────────────────────────────────────────────────────────────
        {
            "name": "SQL / Database Keywords",
            "scope": [
                "keyword.other.sql",
                "constant.other.database-name",
                "constant.other.table-name"
            ],
            "settings": { "foreground": "#9bf" }
        },

        //? ─── Python ─────────────────────────────────────────────────────────────────────────
        {
            "name": "Python Magic Methods",
            "scope": ["support.function.magic", "support.variable.magic"],
            "settings": {
                "foreground": "#cae",
                "fontStyle": ""
            }
        },

        //? ─── Preprocessor / Region Directives ───────────────────────────────────────────────
        {
            "name": "Region Directives (#region)",
            "scope": [
                "keyword.preprocessor.region",
                "meta.preprocessor.region",
                "keyword.control.region",
                "keyword.control.directive.region"
            ],
            "settings": { "foreground": "#9c6" }
        },
        {
            "name": "Region Title",
            "scope": [
                "meta.preprocessor.region string",
                "comment.line.region",
                "meta.toc-list.region.name"
            ],
            "settings": {
                "foreground": "#8cf",
                "fontStyle": ""
            }
        },

        //? ─── Java ───────────────────────────────────────────────────────────────────────────
        {
            "name": "Java Annotations & Package Types",
            "scope": [
                "punctuation.definition.annotation",
                "storage.modifier.import",
                "storage.modifier.package",
                "storage.type.annotation",
                "storage.type.generic",
                "storage.type.java"
            ],
            "settings": { "foreground": "#fc7" }
        },

        //? ─── Object Literal Keys ─────────────────────────────────────────────────────────────
        {
            "name": "Object Literal Keys",
            "scope": ["meta.object-literal.key"],
            "settings": { "foreground": "#e66" }
        }
    ]
}