// F5: the nine themes in an Extension Development Host. Every installed
// extension is off (`--disable-extensions`): this window is for looking at the
// colours, and an installed Atria, Railyard, Bays or CodeLover would only put
// their old views in it. `${workspaceFolder}` and not `${workspaceRoot}`, which
// is ambiguous when this folder is opened inside Lovervoid.code-workspace.
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Dark Mode Lover",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--disable-extensions"
			]
		}
	]
}
